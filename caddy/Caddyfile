{
  admin off
}

# Cloudflare termine le TLS — le Pi reçoit du HTTP plain sur :80.
# Les blocs domaine activeraient HTTPS automatiquement (inutile + cassé derrière CF).
# On écoute sur :80 et on route via le header Host.

:80 {
  @simulir   host simulir.kaalynn.fr
  @frambourse host frambourse.kaalynn.fr

  # ── SimulIR ──────────────────────────────────────────────────────────────────
  handle @simulir {
    handle /api/* {
      reverse_proxy backend:8000
    }
    handle /health {
      reverse_proxy backend:8000
    }
    handle {
      reverse_proxy frontend:3000
    }
  }

  # ── FramBourse ───────────────────────────────────────────────────────────────
  # Le préfixe /api est retiré avant transmission au backend FastAPI
  handle @frambourse {
    handle /api/* {
      uri strip_prefix /api
      reverse_proxy frambourse-api:8000
    }
    handle {
      reverse_proxy frambourse-ui:3000
    }
  }

  encode gzip
}
