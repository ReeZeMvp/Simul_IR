{
  admin off
  # Cloudflare est en mode SSL Flexible : il parle HTTP plain au Pi sur :80.
  # Les blocs "domaine:80" désactivent l'HTTPS automatique de Caddy (pas de Let's Encrypt)
  # et routent par Host header — compatible avec n'importe quel proxy Cloudflare.
  auto_https off
}

# ── SimulIR ────────────────────────────────────────────────────────────────────
simulir.kaalynn.fr:80 {
  handle /api/* {
    reverse_proxy backend:8000
  }
  handle /health {
    reverse_proxy backend:8000
  }
  handle {
    reverse_proxy frontend:3000
  }
  encode gzip
}

# ── FramBourse ─────────────────────────────────────────────────────────────────
frambourse.kaalynn.fr:80 {
  handle /api/* {
    uri strip_prefix /api
    reverse_proxy frambourse-api:8000
  }
  handle {
    reverse_proxy frambourse-ui:3000
  }
  encode gzip
}
